--  Loesungen zur Schummel-Galerie: eigene Projekt, gleicher Unit-Name.
--  Beweisen mit:
--
--    alr exec -- gnatprove -P experiment/loesungen/loesungen.gpr --report=all

project Loesungen is

   for Source_Dirs use (".");
   for Object_Dir use "obj";

   package Naming is
      for Spec ("Cheating") use "cheating.ads";
      for Body ("Cheating") use "cheating.adb";
   end Naming;

   --  Gleicher SPARK_Mode-Default wie das Hauptprojekt (spark.adc, UG 4.2.1).
   package Compiler is
      for Local_Configuration_Pragmas use "../../spark.adc";
   end Compiler;

end Loesungen;
